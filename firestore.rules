rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Profiles ----
    // A user can read and write ONLY their own profile document.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Assignments (diagnostics + results + parent phone) ----
    // Readable ONLY by the assigned student or the owning teacher — never by
    // other students. Create is allowed for the owning teacher, or for a student
    // creating their own (e.g. joining a class). Update is allowed for either the
    // owning teacher or the assigned student. Only the teacher can delete.
    match /assignments/{id} {
      allow read: if request.auth != null && (
        resource.data.studentEmail == request.auth.token.email ||
        resource.data.teacherUid == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.teacherUid == request.auth.uid ||
        request.resource.data.studentEmail == request.auth.token.email
      );
      allow update: if request.auth != null && (
        resource.data.teacherUid == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      );
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // ---- Imported tests (a teacher's own question library) ----
    // Only the owning teacher can read or write. Students never read these —
    // the questions are copied onto the student's own assignment when assigned.
    match /tests/{id} {
      allow read: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // ---- Classes ----
    // Any signed-in user can read (a student looks up a class by its join code).
    // Class documents contain NO student personal data (just subject, grades,
    // join code, term dates). Only the owning teacher can create/edit/delete.
    match /classes/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }
  }
}
