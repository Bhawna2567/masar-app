{
  "name": "masar-desktop",
  "version": "1.0.0",
  "description": "Masar — UAE MOE Curriculum Diagnostic & Skill Development",
  "author": "Masar",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ae.masar.app",
    "productName": "Masar",
    "directories": { "output": "installers" },
    "files": ["main.js", "app/**/*", "build/icon.*"],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": { "title": "Masar ${version}" },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Masar"
    }
  }
}
